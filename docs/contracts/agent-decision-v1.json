      ],
      "title": "SelectionDecision",
      "type": "object"
    },
    "ToolDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "enum": [
            "READ_SOURCE",
            "RECORD_SIMULATED_CONFIRMATION",
            "SEND_SIMULATED_ACKNOWLEDGEMENT",
            "SEND_SIMULATED_OPTIONS"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "TOOL",
          "title": "Step Type",
          "type": "string"
        },
        "tool_name": {
          "enum": [
            "read_followup_context",
            "get_approved_instructions",
            "check_prerequisites",
            "record_simulated_confirmation",
            "send_simulated_acknowledgement",
            "send_simulated_options"
          ],
          "title": "Tool Name",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "tool_name"
      ],
      "title": "ToolDecision",
      "type": "object"
    },
    "WaitDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "enum": [
            "AWAITING_PATIENT_REPLY",
            "SOURCE_TEMPORARILY_UNAVAILABLE"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "WAIT",
          "title": "Step Type",
          "type": "string"
        },
        "wake_after_seconds": {
          "maximum": 300,
          "minimum": 0,
          "title": "Wake After Seconds",
          "type": "integer"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "wake_after_seconds"
      ],
      "title": "WaitDecision",
      "type": "object"
    }
