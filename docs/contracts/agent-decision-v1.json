      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type"
      ],
      "title": "EscalateDecision",
      "type": "object"
    },
    "ReturnDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
