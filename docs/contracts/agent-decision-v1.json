{
  "$defs": {
    "AttendanceDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "const": "PATIENT_ATTENDANCE_REVIEWED",
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "INTERPRET_ATTENDANCE",
          "title": "Step Type",
          "type": "string"
        },
        "reply_event_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Reply Event Id",
          "type": "string"
        },
        "source_step_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Source Step Id",
          "type": "string"
        },
        "confirmed": {
          "title": "Confirmed",
          "type": "boolean"
        },
        "unsupported_question": {
          "default": "NONE",
          "enum": [
            "NONE",
            "WEATHER",
            "PARKING",
            "OTHER_NON_CLINICAL"
          ],
          "title": "Unsupported Question",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "reply_event_id",
        "source_step_id",
        "confirmed"
      ],
      "title": "AttendanceDecision",
      "type": "object"
    },
    "ClinicalReportDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "const": "PATIENT_REPORTED_SYMPTOMS",
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "REPORT_SYMPTOMS",
          "title": "Step Type",
          "type": "string"
        },
        "reply_event_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Reply Event Id",
          "type": "string"
        },
        "symptom_quotes": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Symptom Quotes",
          "type": "array"
        },
        "attendance_quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attendance Quote"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "reply_event_id",
        "symptom_quotes"
      ],
      "title": "ClinicalReportDecision",
      "type": "object"
    },
    "CompleteDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "const": "STAFF_HANDOFF_ACCEPTED",
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "COMPLETE",
          "title": "Step Type",
          "type": "string"
        },
        "handoff_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Handoff Id",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "handoff_id"
      ],
      "title": "CompleteDecision",
      "type": "object"
    },
    "CompleteSimulationDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "const": "SIMULATED_CONFIRMATION_ACKNOWLEDGED",
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "COMPLETE_SIMULATED_CONFIRMATION",
          "title": "Step Type",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "evidence_ids"
      ],
      "title": "CompleteSimulationDecision",
      "type": "object"
    },
    "DelegateDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "enum": [
            "FOLLOWUP_REVIEW_REQUIRED",
            "PREPARATION_REVIEW_REQUIRED"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "DELEGATE",
          "title": "Step Type",
          "type": "string"
        },
        "target": {
          "enum": [
            "engagement",
            "preparation"
          ],
          "title": "Target",
          "type": "string"
        },
        "goal": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Goal",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "target",
        "goal"
      ],
      "title": "DelegateDecision",
      "type": "object"
    },
    "EscalateDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "enum": [
            "AMBIGUOUS_REPLY",
            "CLINICAL_REVIEW_REQUIRED",
