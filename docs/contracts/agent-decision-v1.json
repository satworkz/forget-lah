          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
        "reason_code",
        "step_type",
        "evidence_ids"
      ],
      "title": "ReturnDecision",
      "type": "object"
    },
    "SelectionDecision": {
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Request Id",
          "type": "string"
        },
        "expected_case_version": {
          "minimum": 1,
          "title": "Expected Case Version",
          "type": "integer"
        },
        "reason_code": {
          "const": "PATIENT_SELECTION_REVIEWED",
          "title": "Reason Code",
          "type": "string"
        },
        "step_type": {
          "const": "INTERPRET_SELECTION",
          "title": "Step Type",
          "type": "string"
        },
        "offer_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Offer Id",
          "type": "string"
        },
        "reply_event_id": {
          "maxLength": 36,
          "minLength": 36,
          "title": "Reply Event Id",
          "type": "string"
        },
        "option_number": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Option Number"
        },
        "unsupported_question": {
          "default": "NONE",
          "enum": [
            "NONE",
            "WEATHER",
            "PARKING",
            "OTHER_NON_CLINICAL"
          ],
          "title": "Unsupported Question",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "expected_case_version",
