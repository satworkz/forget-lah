# Generate .env with scripts/dev.ps1 setup. Never commit the generated file.
POSTGRES_OWNER_PASSWORD=
POSTGRES_APP_PASSWORD=
POSTGRES_MOCK_PASSWORD=
MOCK_CLINIC_ADMIN_KEY=
DEMO_STAFF_EMAIL=staff@forget-lah.example
DEMO_STAFF_PASSWORD=
WEB_PORT=8080
# Optional local demo reset button; clears synthetic case history, not credentials or usage.
DEMO_RESET_ENABLED=false
AGENT_AUTO_START_ENABLED=true
# Default: synthetic local demo, with simulated model decisions. No key required.
AGENT_MODEL_MODE=mock
# Optional direct Claude API. Set mode to anthropic after following docs/CLAUDE_SETUP.md.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Only needed for a key that can access multiple workspaces.
ANTHROPIC_WORKSPACE_ID=
# Optional live inference. Follow docs/AGENT_RUNTIME.md before switching mode.
# Store the organiser's private URL/key only in your untracked .env.
LLM_GATEWAY_URL=
LLM_GATEWAY_API_KEY=
LLM_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
AGENT_DAILY_CALL_LIMIT=40
AGENT_REQUEST_MAX_BYTES=8000
AGENT_MIN_INTERVAL_SECONDS=2

# Local-only patient conversation and attendance confirmation testing.
PATIENT_SIMULATOR_ENABLED=true
# Generated by scripts/dev.ps1 setup; never commit the real value.
MOCK_CLINIC_FOLLOWUP_KEY=
